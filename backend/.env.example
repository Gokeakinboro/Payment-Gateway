# ─── Paylode Backend — Environment Variables ────────────────────────────────
# Copy to .env and fill in your values
# NEVER commit .env to git

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://paylode:CHANGE_ME@localhost:5432/paylode_db"

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
APP_URL=https://paylodeservices.com
API_URL=https://api.paylodeservices.com

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_USE_64_RANDOM_CHARS
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=CHANGE_ME_ANOTHER_64_RANDOM_CHARS
REFRESH_TOKEN_EXPIRES_IN=30d

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=CHANGE_ME
EMAIL_FROM=noreply@paylodeservices.com
EMAIL_SUPPORT=support@paylodeservices.com

# ── File Storage (Cloudflare R2 or AWS S3) ───────────────────────────────────
S3_BUCKET=paylode-kyc-docs
S3_REGION=us-east-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com

# ── Encryption (for settlement account numbers) ──────────────────────────────
ENCRYPTION_KEY=CHANGE_ME_32_BYTES_HEX_64_CHARS

# ── Webhook ───────────────────────────────────────────────────────────────────
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY_MS=30000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── CBN / Compliance ──────────────────────────────────────────────────────────
CBN_LICENSE_NO=CBN/PAY/2024/001847
COMPLIANCE_EMAIL=compliance@paylodeservices.com

# ── NIBSS EasyPay (payout rail — KEEP DISABLED until VPN live + NDD profiled) ─
# Set NIBSS_EASYPAY_ENABLED=true ONLY after: VPN tunnel active, sandbox tested,
# NDD profiling confirmed, payment_rails DB row created, and SA sign-off.
NIBSS_EASYPAY_ENABLED=false
NIBSS_EASYPAY_AUTH_URL=https://apitest.nibss-plc.com.ng/v2/reset
NIBSS_EASYPAY_BASE_URL=https://apitest.nibss-plc.com.ng/nipservice/v1
NIBSS_EASYPAY_CLIENT_ID=CHANGE_ME
NIBSS_EASYPAY_CLIENT_SECRET=CHANGE_ME
NIBSS_EASYPAY_INSTITUTION_CODE=CHANGE_ME
NIBSS_EASYPAY_DEBIT_ACCOUNT=CHANGE_ME
NIBSS_EASYPAY_ORIGINATOR_NAME=PAYLODE SERVICES LIMITED
NIBSS_EASYPAY_ORIGINATOR_BVN=CHANGE_ME

# ── NIBSS FAS — BVN + NIN identity validation ───────────────────────────────
NIBSS_FAS_AUTH_URL=https://apitest.nibss-plc.com.ng/v2/reset
NIBSS_FAS_BASE_URL=https://apitest.nibss-plc.com.ng/cvs/v2
NIBSS_FAS_CLIENT_ID=CHANGE_ME
NIBSS_FAS_CLIENT_SECRET=CHANGE_ME
NIBSS_FAS_INSTITUTION_CODE=CHANGE_ME
NIBSS_FAS_SUBCLASS=1

# ── NIBSS Consent Hub — BVN consent (prerequisite for FAS BVN Core) ─────────
NIBSS_CONSENT_HUB_AUTH_URL=https://apitest.nibss-plc.com.ng/v2/reset
NIBSS_CONSENT_HUB_BASE_URL=https://apitest.nibss-plc.com.ng/api
NIBSS_CONSENT_HUB_CLIENT_ID=CHANGE_ME
NIBSS_CONSENT_HUB_CLIENT_SECRET=CHANGE_ME
NIBSS_CONSENT_HUB_CALLBACK_URL=https://api.paylodeservices.com/api/v1/webhooks/nibss/consent
NIBSS_DATA_CONTROLLER_ID=d6378b2e-092f-485a-a1f9-f97b3ca8c3f3

# ── KYC Verification APIs ────────────────────────────────────────────────────
# VERIFYME_API_KEY=CHANGE_ME
# SMILEID_API_KEY=CHANGE_ME

# ── Nomba MFB (payout rail + virtual accounts) ───────────────────────────────
# Set NOMBA_BASE_URL to https://api.nomba.com for production.
# Sandbox default is https://sandbox.nomba.com.
NOMBA_BASE_URL=https://sandbox.nomba.com
NOMBA_CLIENT_ID=CHANGE_ME
NOMBA_CLIENT_SECRET=CHANGE_ME
NOMBA_ACCOUNT_ID=CHANGE_ME
NOMBA_SENDER_NAME=Paylode Services
NOMBA_CALLBACK_URL=https://api.paylodeservices.com/api/v1/webhooks/nomba/payout

# ── AI Chat Assistant ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=CHANGE_ME
# MODULE_CHAT_ENABLED=off  # uncomment to disable the chat widget API
